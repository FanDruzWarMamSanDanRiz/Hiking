<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Outdoor Adventure Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    background:#eef5ee;
    color:#333;
    line-height:1.6;
}

header{
    background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
    url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=80');
    background-size:cover;
    background-position:center;
    height:100vh;
    display:flex;
    flex-direction:column;
}

nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 8%;
    background:rgba(0,0,0,.3);
    position:sticky;
    top:0;
}

.logo{
    color:#fff;
    font-size:28px;
    font-weight:bold;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav ul li a:hover{
    color:#9be15d;
}

.hero{
    flex:1;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    color:white;
    text-align:center;
    padding:20px;
}

.hero h1{
    font-size:60px;
    margin-bottom:20px;
}

.hero p{
    max-width:700px;
    font-size:20px;
}

.btn{
    margin-top:35px;
    display:inline-block;
    background:#2e7d32;
    color:white;
    text-decoration:none;
    padding:15px 35px;
    border-radius:40px;
    transition:.3s;
    font-weight:bold;
}

.btn:hover{
    background:#1b5e20;
}

section{
    padding:70px 8%;
}

.title{
    text-align:center;
    margin-bottom:40px;
}

.title h2{
    font-size:36px;
    color:#1b5e20;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:25px;
}

.card{
    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 8px 18px rgba(0,0,0,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-content{
    padding:20px;
}

.card-content h3{
    color:#1b5e20;
    margin-bottom:10px;
}

.price{
    color:#e65100;
    font-size:22px;
    font-weight:bold;
    margin:10px 0;
}

.about{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:40px;
    align-items:center;
}

.about img{
    width:100%;
    border-radius:15px;
}

.about-text h2{
    color:#1b5e20;
    margin-bottom:20px;
}

.feature{
    background:#1b5e20;
    color:white;
}

.feature-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:25px;
}

.box{
    background:rgba(255,255,255,.08);
    padding:25px;
    border-radius:12px;
    text-align:center;
}

.box h3{
    margin:15px 0;
}

footer{
    background:#111;
    color:#ddd;
    text-align:center;
    padding:25px;
}

@media(max-width:768px){

.hero h1{
    font-size:42px;
}

nav{
    flex-direction:column;
}

nav ul{
    margin-top:15px;
}

}
</style>

</head>
<body>

<header>

<nav>
<div class="logo">🏕 Outdoor Gear</div>

<ul>
<li><a href="#">Home</a></li>
<li><a href="#">Produk</a></li>
